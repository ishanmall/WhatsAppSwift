{
  "manifest_version": 3,
  "name": "WhatsAppSwift v2.0 — Contact Status & Channel Status Downloader",
  "version": "2.0.0",
  "minimum_chrome_version": "109",
  "description": "Downloads WhatsApp Contact Statuses + WhatsApp Channel Statuses (Single & 3-Room Bulk) with Decrypted Blob Vault & FNV-1a Deduplication.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsAppSwift v2.0"
  }
}